Project photo_album_organizer {
  Note: '''
    # 資料模型：照片相簿整理器

    **功能分支**：`001-photo-album-organizer`

    ## 交易邊界

    | 交易 | 範圍 | 失敗處理 |
    |---|---|---|
    | 匯入一張照片 | 檔案已就位後，在同一交易建立不存在的相簿並插入 photos；custom 模式下新相簿 position = MIN(position) - 1 | 交易失敗則刪除剛搬入的檔案，相簿中不留下殘缺列 |
    | 第一次自訂排序 | 依目前日期順序寫入所有 albums.position，並將 album_order_mode 改為 custom | 整筆回滾，模式維持 date |
    | 移動相簿 | 位移區間內 position，再更新被移動相簿的 position | 整筆回滾，前端還原為上一次成功順序 |
    | 刪除照片 | 刪除 photos 列；若該相簿已無照片則刪除 albums 列 | 整筆回滾，檔案刪除只在交易成功後執行 |
  '''
}

Table albums {
  id char(36) [pk, note: '相簿識別']
  album_date date [not null, note: '代表日期，一天一本']
  position int [null, default: null, note: '自訂順序下的位置；日期模式下不使用']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '建立時間']

  indexes {
    album_date [unique, name: 'uk_albums_album_date']
    position [name: 'ix_albums_position']
  }

  Note: '保存每一個拍攝日期對應的相簿，以及使用者自訂順序。'
}

Table photos {
  id char(36) [pk, note: '照片識別']
  album_id char(36) [not null, note: '所屬相簿']
  content_hash char(64) [not null, note: '檔案內容 SHA-256，用於去重']
  taken_at datetime [not null, note: '拍攝當地時間，無時區']
  date_estimated tinyint [not null, default: 0, note: '1 表示日期為推估']
  has_thumbnail tinyint [not null, default: 0, note: '1 表示已有縮圖檔']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '匯入完成時間']

  indexes {
    content_hash [unique, name: 'uk_photos_content_hash']
    (album_id, taken_at, id) [name: 'ix_photos_album_taken', note: '供相簿內游標分頁']
  }

  Note: '保存每一張已匯入照片的中繼資料；檔案本體不存放於此。'
}

Table app_settings {
  setting_key varchar(64) [pk, note: '設定鍵']
  setting_value varchar(255) [not null, note: '設定值']

  Note: '''
    保存應用程式層級設定，目前用於相簿排序模式。
    預設列：album_order_mode = date。取值為 date 或 custom。
  '''
}

Ref fk_photos_album_id: photos.album_id > albums.id [delete: cascade]
